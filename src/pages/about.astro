---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailtoCta from '../components/MailtoCta.astro';
import { companyName, email, ownerName, pageTitle } from '../data/site';

const description = `${companyName} is an Estonian private limited company. Owner and director: ${ownerName}.`;
---

<BaseLayout title={pageTitle('About Vogon Partners')} description={description} currentPath="/about">
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>About Vogon Partners</h1>
      <p>
        {companyName} is an Estonian private limited company. Owner and director: {ownerName}.
      </p>
      <p>
        We do professional software and systems work, and we build our own products – Trip and Move.
      </p>
      <p>
        This page stays short on purpose. No mission essay, no client list, no partnership theatre.
      </p>
      <p>
        Contact: <a href={`mailto:${email}`}>{email}</a>
      </p>
      <MailtoCta label={`Email ${email}`} />
    </article>
  </div>
</BaseLayout>
