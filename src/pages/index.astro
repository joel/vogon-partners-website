---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailtoCta from '../components/MailtoCta.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import { companyName, email, pageTitle } from '../data/site';

const description =
  'Trip and Move are real products with public source, proof of how we build, not a slogan.';
---

<BaseLayout title={pageTitle('We ship the systems we talk about.')} description={description} currentPath="/">
  <div class="page-wrap">
    <p class="eyebrow">{companyName}</p>
    <h1>We ship the systems we talk about.</h1>
    <p class="lede">
      Trip and Move are real products with public source, proof of how we build, not a slogan.
    </p>
    <p>
      Vogon Partners is an Estonian company for professional software and systems work. We also
      design and operate smart home environments, and we talk with operators who want less friction
      in how their work runs. Compliance consulting is coming soon.
    </p>

    <section class="section" aria-labelledby="products-heading">
      <h2 class="section__title" id="products-heading">Products</h2>
      <div class="card-grid">
        <a class="card" href="/showroom/trip">
          <h3>Trip</h3>
          <p>
            A collaborative trip journal: shared memberships, media, checklists, and an assistant
            surface over MCP.
          </p>
          <span class="card__meta">github.com/joel/trip</span>
        </a>
        <a class="card" href="/showroom/move">
          <h3>Move</h3>
          <p>
            A moving-inventory app: pack, recognise, search, unpack, with hybrid search and
            careful multi-tenant design.
          </p>
          <span class="card__meta">move-easy.org · github.com/joel/move</span>
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="offers-heading">
      <h2 class="section__title" id="offers-heading">Ways we can help</h2>
      <div class="card-grid card-grid--3">
        <a class="card" href="/services/smart-environment">
          <h3>Smart environments</h3>
          <p>
            Vendor-neutral, privacy-minded home automation, usually Home Assistant on hardware you
            control.
          </p>
        </a>
        <a class="card" href="/services/ai-operations">
          <h3>AI-assisted operational improvement</h3>
          <p>
            Start with one bottleneck. Fix the work with process, software, or automation, and AI
            only where it earns its keep.
          </p>
        </a>
        <ComingSoonCard heading="h3" />
      </div>
    </section>

    <section class="section">
      <MailtoCta label={`Email ${email}`} />
    </section>
  </div>
</BaseLayout>
