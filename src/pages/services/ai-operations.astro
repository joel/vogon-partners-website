---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MailtoCta from '../../components/MailtoCta.astro';
import { email, pageTitle, subjects } from '../../data/site';

const description = 'Find the friction. Fix the work. Use AI only where it adds leverage.';
---

<BaseLayout
  title={pageTitle('AI-assisted operational improvement')}
  description={description}
  currentPath="/services/ai-operations"
>
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>AI-assisted operational improvement</h1>
      <p class="lede">Find the friction. Fix the work. Use AI only where it adds leverage.</p>

      <h2>For</h2>
      <p>
        Operators and small organisations stuck in repetitive coordination, manual handoffs, or tool
        sprawl.
      </p>

      <h2>Point of view</h2>
      <p>
        Bolting a model onto a broken process usually creates another dashboard. We start with one
        named bottleneck.
      </p>

      <h2>How a first conversation goes</h2>
      <ol class="numbered-tight">
        <li>Name the bottleneck.</li>
        <li>Separate process problems from software problems from information stalls.</li>
        <li>Decide where automation or an agent surface helps, and where it does not.</li>
        <li>
          Look at patterns from products we ship (below) as engineering examples, not as your ROI.
        </li>
        <li>Agree data and secrets boundaries before any deeper access.</li>
      </ol>

      <h2>Engineering we can show</h2>
      <p>From Trip and Move:</p>
      <ul class="list">
        <li>
          MCP tools that call the same application actions as the UI, so agents do not get a weaker
          back door
        </li>
        <li>
          Vision-assisted recognition with bring-your-own-key providers (Move)
        </li>
        <li>
          Hybrid search: full-text, trigram, and vector embeddings (Move)
        </li>
      </ul>
      <p>
        See <a href="/showroom">Trip and Move in the Showroom</a>.
      </p>

      <p>
        Email <strong>{email}</strong>
      </p>
      <p class="muted">Subject: <span class="mono">{subjects.aiOps}</span></p>
      <p>Include one repetitive bottleneck and your data-access constraints.</p>
      <MailtoCta subject={subjects.aiOps} label={`Email ${email}`} />
    </article>
  </div>
</BaseLayout>
