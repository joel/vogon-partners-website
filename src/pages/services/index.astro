---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoonCard from '../../components/ComingSoonCard.astro';
import { pageTitle } from '../../data/site';

const description =
  'Two exploratory service directions, plus a compliance line that is coming soon. Engineering proof lives in the Showroom (Trip and Move); it is not a consulting case library.';
---

<BaseLayout title={pageTitle('Services')} description={description} currentPath="/services">
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>Services</h1>
      <p>
        We publish two exploratory service directions. Each page explains what a first conversation
        covers. Engineering proof lives in the Showroom (Trip and Move); it is not a consulting case
        library. A compliance consulting line is coming soon.
      </p>
    </article>

    <div class="card-grid card-grid--3">
      <a class="card" href="/services/smart-environment">
        <h2>Smart environments</h2>
        <p>
          Private, vendor-neutral home automation, typically Home Assistant-centred, with local
          control and clear architecture as design preferences. Installations we build and operate.
        </p>
      </a>
      <a class="card" href="/services/ai-operations">
        <h2>AI-assisted operational improvement</h2>
        <p>
          Find repetitive coordination and information bottlenecks; decide honestly whether
          software, automation, or AI-assisted workflows are the right lever.
        </p>
      </a>
      <ComingSoonCard heading="h2" />
    </div>

    <section class="section prose-measure">
      <h2>Engineering proof (not a service catalogue)</h2>
      <p>
        Trip and Move: MCP surfaces, vision recognition, hybrid search, and production-minded Rails
        engineering.
      </p>
      <p>
        <a href="/showroom">See the Showroom</a>
      </p>
      <p class="muted">No pricing, client logos, or ROI percentages on this page.</p>
    </section>
  </div>
</BaseLayout>
