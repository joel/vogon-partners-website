---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoonCard from '../../components/ComingSoonCard.astro';
import { pageTitle } from '../../data/site';

const description =
  'Two directions we are ready to discuss, plus engineering you can inspect in the showroom.';
---

<BaseLayout title={pageTitle('Services')} description={description} currentPath="/services">
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>Services</h1>
      <p>
        Two directions we are ready to discuss, plus engineering you can inspect in the showroom.
      </p>
    </article>

    <div class="card-grid card-grid--3">
      <a class="card" href="/services/smart-environment">
        <h2>Smart environments</h2>
        <p>
          Home Assistant centred automation with local control where it matters.
        </p>
      </a>
      <a class="card" href="/services/ai-operations">
        <h2>AI-assisted operational improvement</h2>
        <p>
          Remove operational friction; use AI only when it helps.
        </p>
      </a>
      <ComingSoonCard heading="h2" />
    </div>

    <section class="section prose-measure">
      <p>
        Trip and Move show how we ship software. They are not a consulting case library.
      </p>
      <p>
        <a href="/showroom">See the Showroom</a>
      </p>
      <p class="muted">No pricing or ROI figures on this page.</p>
    </section>
  </div>
</BaseLayout>
