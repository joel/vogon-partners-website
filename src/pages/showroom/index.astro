---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links, pageTitle } from '../../data/site';

const description =
  'Trip and Move are real products with public source, proof of how we build, not a slogan.';
---

<BaseLayout title={pageTitle('Showroom')} description={description} currentPath="/showroom">
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>Showroom</h1>
      <p>
        Trip and Move are real products with public source, proof of how we build, not a slogan.
      </p>
    </article>

    <div class="card-grid">
      <a class="card" href="/showroom/trip">
        <h2>Trip</h2>
        <p>
          A collaborative trip journal: shared memberships, media, checklists, and an assistant
          surface over MCP.
        </p>
        <span class="card__meta">github.com/joel/trip · Live demo not linked yet</span>
      </a>
      <a class="card" href="/showroom/move">
        <h2>Move</h2>
        <p>
          A moving-inventory app: pack, recognise, search, unpack, with hybrid search and careful
          multi-tenant design.
        </p>
        <span class="card__meta">move-easy.org · github.com/joel/move</span>
      </a>
    </div>

    <p class="muted source-line">
      Source:
      {' '}
      <a href={links.tripGithub}>github.com/joel/trip</a>
      {' · '}
      <a href={links.moveGithub}>github.com/joel/move</a>
      {' · '}
      <a href={links.moveLive}>move-easy.org</a>
    </p>
  </div>
</BaseLayout>
