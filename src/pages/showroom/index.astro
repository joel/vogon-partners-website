---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links, pageTitle } from '../../data/site';

const description =
  'You can inspect how we build. Trip and Move are real applications with public source. Engineering proof, not a consulting case library.';
---

<BaseLayout title={pageTitle('Showroom')} description={description} currentPath="/showroom">
  <div class="page-wrap">
    <article class="prose-measure">
      <h1>Showroom</h1>
      <p>
        You can inspect how we build. Trip and Move are real applications with public source: MCP
        assistant surfaces, careful auth and tenancy, hybrid search, production-minded Rails
        engineering.
      </p>
      <p>
        Engineering proof lives in the Showroom (Trip and Move); it is not a consulting case
        library.
      </p>
    </article>

    <div class="card-grid">
      <a class="card" href="/showroom/trip">
        <h2>Trip</h2>
        <p>
          A collaborative trip journal (Rails) with shared memberships, media, checklists, and an
          MCP assistant surface.
        </p>
        <span class="card__meta">GitHub only. Live demo not linked yet</span>
      </a>
      <a class="card" href="/showroom/move">
        <h2>Move</h2>
        <p>
          A collaborative moving-inventory app: pack, recognise, search, unpack, with hybrid search
          and careful multi-tenant design.
        </p>
        <span class="card__meta">move-easy.org · GitHub</span>
      </a>
    </div>

    <p class="muted source-line">
      Source:
      {' '}
      <a href={links.tripGithub}>github.com/joel/trip</a>
      {' · '}
      <a href={links.moveGithub}>github.com/joel/move</a>
      {' · '}
      <a href={links.moveLive}>move-easy.org</a>
    </p>
  </div>
</BaseLayout>
