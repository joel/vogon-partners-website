---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MailtoCta from '../../components/MailtoCta.astro';
import { email, links, pageTitle, subjects } from '../../data/site';

const description =
  'A collaborative moving-inventory app. Live at move-easy.org. Built by Vogon Partners.';
---

<BaseLayout title={pageTitle('Move')} description={description} currentPath="/showroom/move">
  <div class="page-wrap">
    <article class="prose-measure">
      <p class="eyebrow">Showroom</p>
      <h1>Move</h1>

      <h2>What it is</h2>
      <p>
        A collaborative moving-inventory app. Live at <a href={links.moveLive}>move-easy.org</a>.
        Built by Vogon Partners.
      </p>

      <h2>Problem</h2>
      <p>
        Moving loses context: which box, what is fragile, insurance lists, “where is X?”, and
        unpacking fatigue.
      </p>

      <h2>Engineering worth noticing</h2>
      <ul class="list">
        <li>Box lifecycle with QR labels.</li>
        <li>BYOK vision for contents.</li>
        <li>Hybrid search.</li>
        <li>Schema-per-organisation tenancy.</li>
        <li>MCP tools bound to a move.</li>
        <li>Insurance PDF flows.</li>
      </ul>

      <h2>Why it is on this site</h2>
      <p>
        Shows multi-tenant Rails product design and AI-assisted capture with an honest application
        boundary.
      </p>

      <h2>Links</h2>
      <ul class="list">
        <li>Product: <a href={links.moveLive}>move-easy.org</a></li>
        <li>GitHub: <a href={links.moveGithub}>{links.moveGithub.replace('https://', '')}</a></li>
      </ul>

      <p class="muted">Subject: <span class="mono">{subjects.showroom}</span></p>
      <MailtoCta subject={subjects.showroom} label={`Email ${email} about Move`} />
    </article>
  </div>
</BaseLayout>
